{
  "name": "partyup",
  "version": "0.2.0",
  "description": "PartyUp desktop cabinet. RomM-style library for games you own.",
  "main": "dist-electron/index.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "dist:win": "vite build && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.2",
    "framer-motion": "^11.11.0",
    "i18next": "^23.16.0",
    "jotai": "^2.10.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.1.0",
    "sql.js": "^1.11.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "electron": "^28.3.3",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.9",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "build": {
    "appId": "app.partyup.desktop",
    "productName": "PartyUp",
    "files": ["dist", "dist-electron"],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PartyUp"
    }
  }
}
